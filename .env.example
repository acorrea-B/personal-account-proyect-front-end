# Public (client-exposed) configuration. No secrets belong here.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog browser analytics configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Test-only secrets. Never expose to the client (no NEXT_PUBLIC_).
# Used to encrypt/decrypt API cassettes for tests. Local: .env.local; CI: GitHub Secret.
CASSETTE_ENCRYPTION_KEY=
